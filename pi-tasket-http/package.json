{
  "name": "@pi-extensions/pi-tasket-http",
  "version": "1.0.0",
  "description": "Tasket++ HTTP Trigger tools for pi agents — schedule, track, and execute Windows automation macros remotely",
  "author": "Pi Extensions Community",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/pi-extensions/pi-tasket-http.git"
  },
  "keywords": [
    "pi",
    "pi-package",
    "agent",
    "tasket",
    "windows",
    "automation",
    "macro",
    "http",
    "remote-control",
    "tasker"
  ],
  "files": [
    "src/**/*.ts",
    "skills/**/*.md",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": ">=0.50.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ __tests__/"
  },
  "devDependencies": {
    "@mariozechner/pi-coding-agent": ">=0.50.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
